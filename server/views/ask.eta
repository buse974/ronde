<% const a = it.ask, h = it.h; const titre = a.kind === 'design' ? 'Créer une ronde avec Claude' : 'Demande'; %>
<% layout('./layout', { ...it, title: titre }) %>
<%
  const running = a.status === 'running';
  const p = a.proposal;
  const essai = a.title.startsWith('Essai : ');
  // Panneau latéral : ce que la conversation peut devenir.
  const avecVolet = !essai && (a.kind === 'design' || a.status === 'done');
%>
<p class="petit"><a href="/tasks">Toutes les rondes</a></p>
<h1><%= titre %></h1>
<% if (it.error) { %><p class="note attention"><%= it.error %></p><% } %>

<div class="<%= avecVolet ? 'echange' : '' %>">
<div class="fil">
  <div class="conversation">
    <% a.messages.forEach((m, i) => { const last = i === a.messages.length - 1; %>
      <% if (m.role === 'history') { if (it.debug) { %><%~ include('./partials/history-entry', { ...it, m }) %><% } return; } %>
      <div class="bulle <%= m.role === 'user' ? 'moi' : 'claude' %>"<%~ m.role === 'claude' && last && a.messages.length > 2 ? ' id="derniere"' : '' %>>
        <span class="qui"><%= m.role === 'user' ? 'Toi' : 'Claude' %></span>
        <div><%= m.text %></div>
      </div>
    <% }) %>
    <% if (running) { %><%~ include('./partials/ask-running', it) %><% } %>
  </div>

  <% if (a.status === 'failed') { %>
    <p class="note mal"><%= a.error %></p>
    <% if (a.result) { %><details><summary>Détail</summary><pre><%= a.result %></pre></details><% } %>
  <% } %>

  <% if (!running) { %>
  <form method="post" action="/asks/<%= a.id %>/reply" class="repondre demander-form">
    <label for="reply" class="masque">Continuer la conversation</label>
    <textarea id="reply" name="text" rows="2" required placeholder="<%= a.kind === 'design' ? (a.status === 'proposal' ? 'Un ajustement ? Par exemple : plutôt toutes les 30 minutes.' : 'Réponds à Claude.') : 'Continuer, par exemple : et sur /boot ?' %>"></textarea>
    <button type="submit" <%= it.busy ? 'disabled' : '' %>>Envoyer</button>
  </form>
  <% } %>
  <p class="petit discret">Coût estimé de la conversation : <%= h.cost(a.cost_usd) %>.</p>
</div>

<% if (avecVolet) { %>
<aside class="volet" aria-label="Ce que cette conversation peut devenir">

  <% if (a.kind === 'exec') { %>
  <section class="carte genre-ronde">
    <p class="surtitre">Ronde</p>
    <h2><%= a.suggest_ronde ? 'À surveiller régulièrement' : 'Vérifier ça régulièrement ?' %></h2>
    <p>Claude fixe avec toi la fréquence et les seuils, puis ne te prévient qu'en cas de problème.</p>
    <form method="post" action="/asks/<%= a.id %>/to-ronde"><button type="submit" <%= it.busy ? 'disabled' : '' %>>Créer une ronde</button></form>
  </section>

  <section class="carte genre-oneshot">
    <p class="surtitre">Oneshot</p>
    <h2>Reposer la question plus tard</h2>
    <p>Garde cette demande pour la relancer en un clic, sans planification ni alerte.</p>
    <form method="post" action="/asks/<%= a.id %>/keep"><button type="submit" class="secondaire">Garder en oneshot</button></form>
  </section>
  <% } else { %>
  <section class="carte genre-ronde">
    <p class="surtitre">Ronde proposée</p>
    <% if (!p || running) { %>
      <h2>En préparation</h2>
      <p class="discret">La ronde s’affichera ici dès que Claude aura assez d’informations.</p>
    <% } else { %>
      <h2><%= p.name || 'Sans nom' %></h2>
      <dl class="fiche serree">
        <dt>Quand</dt><dd><%= p.cron ? h.cronText(p.cron) : 'À la demande' %><% if (p.cron) { %><br><code><%= p.cron %></code><% } %></dd>
        <dt>Outils</dt><dd><%= (p.allowed_tools || []).join(', ') || 'aucun' %></dd>
        <dt>Tours</dt><dd><%= p.max_turns %> au maximum</dd>
      </dl>
      <% if (p.error) { %><p class="note attention">À corriger avant de créer : <%= p.error %>. Demande à Claude d'ajuster.</p><% } %>
      <details><summary>Prompt de la ronde</summary><pre><%= p.prompt %></pre></details>
      <div class="actions">
        <form method="post" action="/asks/<%= a.id %>/create"><button type="submit" <%= p.error ? 'disabled' : '' %>>Créer la ronde</button></form>
        <form method="post" action="/asks/<%= a.id %>/try"><button type="submit" class="secondaire" <%= it.busy ? 'disabled' : '' %>>Essayer</button></form>
      </div>
      <p class="aide">« Essayer » la lance une fois sans l’enregistrer. Tu pourras toujours la faire modifier par Claude ensuite.</p>
    <% } %>
  </section>
  <% } %>

</aside>
<% } %>
</div>
