<% layout('./layout', { ...it, title: it.ask.kind === 'design' ? 'Créer une ronde avec Claude' : 'Demande' }) %>
<% const a = it.ask, h = it.h; %>
<p class="petit"><a href="/tasks#demander">Toutes les rondes</a></p>
<h1><%= a.kind === 'design' ? 'Créer une ronde avec Claude' : 'Demande' %></h1>
<% if (it.error) { %><p class="note attention"><%= it.error %></p><% } %>

<div class="conversation">
  <% a.messages.forEach((m, i) => { %>
    <div class="bulle <%= m.role === 'user' ? 'moi' : 'claude' %><%= m.role === 'claude' && a.kind === 'exec' && a.is_ras && i === a.messages.length - 1 ? ' ras' : '' %>">
      <span class="qui"><%= m.role === 'user' ? 'Toi' : 'Claude' %></span>
      <div><%= m.text %></div>
    </div>
  <% }) %>
  <% if (a.status === 'running') { %><%~ include('./partials/ask-running', it) %><% } %>
</div>

<% if (a.status === 'failed') { %>
  <p class="note mal"><%= a.error %></p>
  <% if (a.result) { %><details><summary>Détail</summary><pre><%= a.result %></pre></details><% } %>
<% } %>

<% if (a.kind === 'exec' && a.status === 'done' && !a.title.startsWith('Essai : ')) { %>
<form method="post" action="/asks/<%= a.id %>/keep" class="garder"><button type="submit" class="secondaire compact">Garder en oneshot</button></form>
<% } %>
<% if (a.kind === 'exec' && a.suggest_ronde && a.status === 'done') { %>
<div class="suggestion">
  <p>Ça pourrait devenir une ronde : Claude referait cette vérification régulièrement et ne te préviendrait qu'en cas de problème. On la crée ?</p>
  <form method="post" action="/asks/<%= a.id %>/to-ronde"><button type="submit" <%= it.busy ? 'disabled' : '' %>>Oui, créer une ronde</button></form>
</div>
<% } %>

<% if (a.kind === 'design' && a.proposal && a.status !== 'running') { const p = a.proposal; %>
<article class="proposition">
  <h2><%= p.name || 'Ronde proposée' %></h2>
  <p><%= p.cron ? h.cronText(p.cron) : 'Ronde manuelle' %><% if (p.cron) { %> <span class="discret">(<code><%= p.cron %></code>)</span><% } %>. Outils : <%= (p.allowed_tools || []).join(', ') || 'aucun' %>. Tours maximum : <%= p.max_turns %>.</p>
  <% if (p.error) { %><p class="note attention">À corriger avant de créer : <%= p.error %></p><% } %>
  <details><summary>Prompt de la ronde</summary><pre><%= p.prompt %></pre></details>
  <div class="actions" style="margin-top:1rem">
    <form method="post" action="/asks/<%= a.id %>/try"><button type="submit" class="secondaire" <%= it.busy ? 'disabled' : '' %>>Essayer maintenant</button></form>
    <a href="/tasks/new?from_ask=<%= a.id %>" class="bouton">Ouvrir dans le formulaire</a>
  </div>
  <p class="aide">« Essayer » lance la ronde une fois sans l'enregistrer. Le formulaire te laisse relire et ajuster avant de créer.</p>
</article>
<% } %>

<% if (a.status !== 'running') { %>
<form method="post" action="/asks/<%= a.id %>/reply" class="repondre demander-form">
  <label for="reply" class="masque">Continuer la conversation</label>
  <textarea id="reply" name="text" rows="2" required placeholder="<%= a.kind === 'design' ? (a.status === 'proposal' ? 'Un ajustement ? Par exemple : plutôt toutes les 30 minutes.' : 'Réponds à Claude.') : 'Continuer, par exemple : et sur /boot ?' %>"></textarea>
  <button type="submit" <%= it.busy ? 'disabled' : '' %>>Envoyer</button>
</form>
<% } %>
<p class="petit discret">Coût estimé de la conversation : <%= h.cost(a.cost_usd) %>.</p>
