<% layout('./layout', { ...it, title: 'Connexion' }) %>
<div class="seul">
  <%~ include('./partials/embleme', { cls: 'embleme' }) %>
  <h1>Connexion</h1>
  <% if (it.error) { %><p class="note mal"><%= it.error %></p><% } %>
  <form method="post" action="/login">
    <input type="hidden" name="next" value="<%= it.next %>">
    <label>Identifiant
      <input name="username" value="<%= it.username %>" autocomplete="username" required autofocus>
    </label>
    <label>Mot de passe
      <input type="password" name="password" autocomplete="current-password" required>
    </label>
    <button type="submit">Se connecter</button>
  </form>
</div>
