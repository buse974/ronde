<% layout('./layout', { ...it, title: 'Run #' + it.run.id }) %>
<% const r = it.run, h = it.h; %>
<p><a href="/tasks/<%= r.task_id %>">← <%= r.task_name %></a></p>
<h2>Run #<%= r.id %> <span class="badge <%= r.status %>"><%= h.statusLabel(r.status) %></span></h2>

<% if (r.status === 'running') { %>
  <%~ include('./partials/run-running', it) %>
<% } else { %>
<div class="grid">
  <div>
    <p><strong>Début :</strong> <%= h.date(r.started_at) %><br>
       <strong>Fin :</strong> <%= h.date(r.finished_at) %><br>
       <strong>Durée :</strong> <%= h.duration(r.duration_ms) %><br>
       <strong>Déclencheur :</strong> <%= r.trigger === 'manual' ? 'Manuel' : 'Planifié' %></p>
  </div>
  <div>
    <p><strong>Code de sortie :</strong> <%= r.exit_code ?? '—' %> · <strong>is_error :</strong> <%= r.is_error == null ? '—' : r.is_error ? 'true' : 'false' %><br>
       <strong>Tours :</strong> <%= r.num_turns ?? '—' %><br>
       <strong>Tokens :</strong> <%= h.tokens(r.input_tokens) %> entrée + <%= h.tokens(r.cache_read_tokens) %> cache lu + <%= h.tokens(r.cache_creation_tokens) %> cache écrit · <%= h.tokens(r.output_tokens) %> sortie<br>
       <strong>Coût estimé :</strong> <%= h.cost(r.cost_usd) %> <small class="muted">(équivalent API<%= r.token_type === 'oauth' ? ', pris sur le quota de l’abonnement' : r.token_type === 'api' ? ', facturé sur la clé API' : '' %>)</small><br>
       <strong>Alerte mail :</strong> <%= r.alert_sent ? 'envoyée' : (r.status === 'ok' ? 'non nécessaire' : 'non envoyée') %></p>
  </div>
</div>

<% if (r.error) { %><p class="notice error-box"><%= r.error %></p><% } %>

<h3>Réponse de Claude</h3>
<pre><%= r.result ?? '(aucune)' %></pre>

<% if (r.stderr) { %>
<details><summary>stderr</summary><pre><%= r.stderr %></pre></details>
<% } %>
<% if (it.pretty) { %>
<details><summary>JSON brut</summary><pre><%= it.pretty %></pre></details>
<% } %>
<% } %>
