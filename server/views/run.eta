<% layout('./layout', { ...it, title: 'Passage du ' + it.h.short(it.run.started_at) }) %>
<% const r = it.run, h = it.h; %>
<p class="petit"><a href="/tasks/<%= r.task_id %>"><%= r.task_name %></a></p>

<% if (r.status === 'running') { %>
  <div class="verdict"><span class="etat running">En cours</span></div>
  <%~ include('./partials/run-running', it) %>
<% } else { %>
<div class="verdict">
  <span class="etat <%= r.status %>"><%= h.statusLabel(r.status) %></span>
  <span class="discret"><%= h.date(r.started_at) %>, <%= r.trigger === 'manual' ? 'à la demande' : 'planifié' %></span>
</div>

<% if (r.error) { %><p class="note mal"><%= r.error %></p><% } %>

<h3>Réponse de Claude</h3>
<div class="reponse <%= r.status %>"><%= r.result ?? '(aucune réponse)' %></div>

<dl class="fiche">
  <dt>Durée</dt><dd><%= h.duration(r.duration_ms) %></dd>
  <dt>Code de sortie</dt><dd><%= r.exit_code ?? '—' %>, is_error <%= r.is_error == null ? '—' : r.is_error ? 'true' : 'false' %></dd>
  <dt>Tours</dt><dd><%= r.num_turns ?? '—' %></dd>
  <dt>Tokens</dt><dd><%= h.tokens(r.input_tokens) %> en entrée, <%= h.tokens(r.cache_read_tokens) %> lus en cache, <%= h.tokens(r.cache_creation_tokens) %> écrits en cache, <%= h.tokens(r.output_tokens) %> en sortie</dd>
  <dt>Coût estimé</dt><dd><%= h.cost(r.cost_usd) %> <span class="discret">(équivalent API<%= r.token_type === 'oauth' ? ', pris sur le quota de l’abonnement' : r.token_type === 'api' ? ', facturé sur la clé API' : '' %>)</span></dd>
  <dt>Mail d'alerte</dt><dd><%= r.alert_sent ? 'envoyé' : (r.status === 'ok' ? 'inutile' : 'non envoyé') %></dd>
</dl>

<% if (r.stderr) { %><details><summary>Sortie d'erreur</summary><pre><%= r.stderr %></pre></details><% } %>
<% if (it.pretty) { %><details><summary>JSON brut</summary><pre><%= it.pretty %></pre></details><% } %>
<% } %>
