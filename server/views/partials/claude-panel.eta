<%
  // Panneau « Claude » de la page d'une ronde : sa conversation (toujours une), la ronde modifiée proposée, la saisie.
  const c = it.conv, h = it.h, t = it.task;
  const running = c && c.status === 'running';
  const visibles = c ? c.messages.filter((m) => m.role !== 'history') : [];
  const vide = !visibles.length && !running;
  const shown = c ? c.messages.filter((m) => m.role !== 'history' || it.debug) : [];
  const p = c && !running ? c.proposal : null;
%>
<aside class="volet-claude" id="claude" aria-label="Conversation avec Claude sur cette ronde">
  <p class="surtitre">Claude</p>
  <div class="fil-volet">
    <% if (vide && !shown.length) { %>
      <p class="discret">Demande pourquoi elle a répondu ça, ou ce qu'elle devrait faire autrement : Claude te propose la ronde modifiée, tu l'appliques si elle te convient.</p>
    <% } else { %>
      <div class="conversation">
        <% shown.forEach((m) => { %>
          <% if (m.role === 'history') { %><%~ include('./history-entry', { ...it, m }) %><% return; } %>
          <div class="bulle <%= m.role === 'user' ? 'moi' : 'claude' %>">
            <span class="qui"><%= m.role === 'user' ? 'Toi' : 'Claude' %></span>
            <div><%= m.text %></div>
          </div>
        <% }) %>
        <% if (running) { %><%~ include('./ask-running', { ...it, ask: c, live: it.live, back: it.run ? 'run' : 'task' }) %><% } %>
      </div>
      <% if (c.status === 'failed') { %><p class="note mal"><%= c.error %></p><% } %>
    <% } %>

    <% if (c && !running && (c.missing_tools || []).length) { %>
  <section class="carte manque" aria-label="Outils à ajouter">
    <p class="surtitre">Outil manquant</p>
    <p>Claude a besoin d'une règle hors des outils proposables. L'ajouter vaut pour toutes les conversations et pour le MCP, y compris <code>test_prompt</code>.</p>
    <div class="actions">
    <% c.missing_tools.forEach((rule) => { %>
      <form method="post" action="/asks/<%= c.id %>/tools"><input type="hidden" name="rule" value="<%= rule %>"><% if (it.run) { %><input type="hidden" name="back" value="run"><% } %><button type="submit" <%= it.askBusy ? 'disabled' : '' %>>Ajouter <code><%= rule %></code></button></form>
    <% }) %>
    </div>
    <p class="aide">Ou crée la ronde toi-même dans le formulaire manuel, qui accepte toutes les règles.</p>
  </section>
  <% } %>
    <% if (p) { %>
    <section class="carte modif">
      <p class="surtitre">Ronde modifiée</p>
      <dl class="fiche serree">
        <dt>Nom</dt><dd><%= p.name %></dd>
        <dt>Quand</dt><dd><%= p.cron ? h.cronText(p.cron) : 'À la demande' %><% if (p.cron) { %><br><code><%= p.cron %></code><% } %></dd>
        <dt>Outils</dt><dd><%= (p.allowed_tools || []).join(', ') || 'aucun' %></dd>
        <dt>Tours</dt><dd><%= p.max_turns %> au maximum</dd>
      </dl>
      <% if (p.error) { %><p class="note attention">Proposition invalide : <%= p.error %>. <a href="/tasks/<%= t.id %>/edit">Formulaire de la ronde</a></p><% } %>
      <details><summary>Nouveau prompt</summary><pre><%= p.prompt %></pre></details>
      <div class="actions">
        <form method="post" action="/asks/<%= c.id %>/apply"><button type="submit" <%= p.error || t.archived_at ? 'disabled' : '' %>>Appliquer</button></form>
        <form method="post" action="/asks/<%= c.id %>/try"><button type="submit" class="secondaire" <%= it.askBusy || p.error ? 'disabled' : '' %>>Essayer d'abord</button></form>
      </div>
    </section>
    <% } %>
  </div>

  <% if (it.convError) { %><p class="note attention"><%= it.convError %></p><% } %>
  <% if (!running) { %>
  <form method="post" action="/tasks/<%= t.id %>/ask" class="demander-form saisie-volet">
    <label for="claude-text" class="masque">Écrire à Claude</label>
    <% if (it.run) { %><input type="hidden" name="run_id" value="<%= it.run.id %>"><% } %>
    <textarea id="claude-text" name="text" rows="3" required placeholder="<%= it.run ? 'Par exemple : pourquoi cette réponse ?' : t.archived_at ? 'Par exemple : remets-la active.' : vide ? 'Par exemple : pourquoi cette alerte ce matin ?' : 'Par exemple : ok, applique.' %>"></textarea>
    <button type="submit" <%= it.askBusy ? 'disabled' : '' %>>Envoyer</button>
  </form>
  <% if (!vide) { %><p class="petit discret">Coût de la conversation : <%= h.cost(c.cost_usd) %>.</p><% } %>
  <% } %>
</aside>
