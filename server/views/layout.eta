<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#151b2e">
  <title><%= it.title ? it.title + ' – ronde' : 'ronde' %></title>
  <link rel="preload" href="/vendor/fonts/archivo-wdth.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/app.css">
  <script src="/vendor/htmx.min.js" defer></script>
</head>
<body>
  <div class="page">
    <header class="entete">
      <a href="/" class="marque"><%~ include('./partials/embleme', {}) %>ronde</a>
      <% if (it.user) { %>
      <nav class="nav" aria-label="Navigation principale">
        <a href="/tasks" <%~ it.path.startsWith('/tasks') || it.path.startsWith('/runs') ? 'aria-current="page"' : '' %>>Rondes</a>
        <a href="/settings" <%~ it.path.startsWith('/settings') ? 'aria-current="page"' : '' %>>Réglages</a>
        <form method="post" action="/logout"><button type="submit" class="lien">Se déconnecter</button></form>
      </nav>
      <% } %>
    </header>
    <main>
      <%~ it.body %>
    </main>
  </div>
</body>
</html>
