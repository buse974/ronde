<% layout('./layout', { ...it, title: 'Tâches' }) %>
<div class="page-head">
  <h2>Tâches</h2>
  <a href="/tasks/new" role="button">Nouvelle tâche</a>
</div>

<% if (!it.tokenStatus.configured) { %>
<p class="notice warn">Aucun token Claude configuré : les runs échoueront. <a href="/settings">Ajouter un token</a>.</p>
<% } %>

<% if (!it.tasks.length) { %>
<p class="muted">Aucune tâche pour l'instant. Pars d'un modèle ci-dessous, crée une tâche, ou demande à Claude de la concevoir via le MCP (Réglages &gt; Accès MCP).</p>
<% } else { %>
<div class="overflow-auto">
<table class="striped">
  <thead>
    <tr><th>Tâche</th><th>Planification</th><th>Prochain run</th><th>Dernier run</th><th>Coût 30 j</th><th>Active</th><th></th></tr>
  </thead>
  <tbody>
    <% it.tasks.forEach((t) => { %>
      <%~ include('./partials/task-row', { ...it, t }) %>
    <% }) %>
  </tbody>
</table>
</div>
<p class="muted">Coût estimé en équivalent API. Avec un token d'abonnement, il n'est pas facturé : il est pris sur ton quota.</p>
<% } %>

<h3>Modèles</h3>
<div class="grid templates">
  <% Object.entries(it.templates).forEach(([key, t]) => { %>
  <article>
    <header><strong><%= t.name %></strong></header>
    <p><%= t.summary %></p>
    <p class="muted"><small><%= it.h.cronText(t.cron) %> · outils : <%= t.allowed_tools.join(', ') %> · données : <code><%= t.requires %></code> sur l'hôte</small></p>
    <form method="post" action="/tasks/template/<%= key %>" class="inline">
      <button type="submit" class="secondary outline small">Créer depuis ce modèle</button>
    </form>
  </article>
  <% }) %>
</div>
