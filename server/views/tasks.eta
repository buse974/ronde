<% layout('./layout', { ...it, title: 'Rondes' }) %>
<% const s = it.summary, h = it.h; %>

<section class="veille">
  <div>
    <%~ include('./partials/cadran', it) %>
    <div class="legende">
      <span><i class="trait"></i>passage prévu</span>
      <span><i style="background:var(--ras)"></i>RAS</span>
      <span><i style="background:var(--alerte)"></i>alerte</span>
      <span><i style="background:var(--echec)"></i>échec</span>
    </div>
  </div>
  <div>
    <h1><%= s.title %></h1>
    <% if (it.tasks.length) { %>
      <p>
        <% if (s.active) { %><strong><%= s.active %> <%= s.active > 1 ? 'rondes planifiées' : 'ronde planifiée' %></strong><% } else { %>Aucune ronde planifiée<% } %><% if (s.manual) { %>, <%= s.manual %> <%= s.manual > 1 ? 'manuelles' : 'manuelle' %><% } %>.
        <% if (s.next) { %>Prochain passage <strong><%= h.short(s.next.date.toISOString()).split(' ').pop() %></strong> : <%= s.next.name %>.<% } %>
      </p>
      <p>
        <% if (s.total) { %>Depuis hier : <strong><%= s.ok %> RAS</strong><% if (s.alerts) { %>, <strong><%= s.alerts %> <%= s.alerts > 1 ? 'alertes' : 'alerte' %></strong><% } %><% if (s.failed) { %>, <strong><%= s.failed %> <%= s.failed > 1 ? 'échecs' : 'échec' %></strong><% } %>.<% } else { %>Aucun passage depuis hier.<% } %>
      </p>
    <% } else { %>
      <p>Une ronde, c'est un prompt que Claude exécute sur ce serveur, à heure fixe ou à la demande. Il répond « RAS » quand tout va bien, sinon tu reçois une alerte.</p>
    <% } %>
    <div class="actions" style="margin-top:1.5rem">
      <a href="/tasks/new" class="bouton">Nouvelle ronde</a>
    </div>
  </div>
</section>

<%~ include('./partials/demander', it) %>

<% if (!it.tokenStatus.configured) { %>
<p class="note attention">Aucun token Claude : les rondes échoueront. <a href="/settings">Ajouter le token dans les réglages</a>.</p>
<% } %>

<% const planifiees = it.tasks.filter((t) => t.cron || t.run_at), oneshots = it.tasks.filter((t) => !t.cron && !t.run_at); %>
<% if (planifiees.length) { %>
<div class="titre-section"><h2>Rondes</h2></div>
<div class="defile">
<table class="registre">
  <thead>
    <tr><th>Ronde</th><th class="masque-mobile">Fréquence</th><th class="masque-mobile">Prochain passage</th><th>Dernier résultat</th><th class="masque-mobile chiffre">Coût 30 j</th><th class="fin"><span class="discret">Active</span></th></tr>
  </thead>
  <tbody>
    <% planifiees.forEach((t) => { %><%~ include('./partials/task-row', { ...it, t }) %><% }) %>
  </tbody>
</table>
</div>
<% } %>
<% if (oneshots.length) { %>
<div class="titre-section" style="margin-top:2.5rem"><h2>Oneshots</h2></div>
<div class="defile">
<table class="registre">
  <thead>
    <tr><th>Oneshot</th><th>Dernière réponse</th><th class="masque-mobile chiffre">Coût 30 j</th><th class="fin"></th></tr>
  </thead>
  <tbody>
    <% oneshots.forEach((t) => { %><%~ include('./partials/oneshot-row', { ...it, t }) %><% }) %>
  </tbody>
</table>
</div>
<% } %>
<% if (it.tasks.length) { %>
<p class="petit discret">Le coût est un équivalent API indicatif. Avec un token d'abonnement, rien n'est facturé à part : c'est pris sur ton quota.</p>
<% } %>
