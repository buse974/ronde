<% layout('./layout', { ...it, title: 'Réglages' }) %>
<% const t = it.token, e = it.errors; %>
<h1>Réglages</h1>
<% if (it.notice) { %><p class="note bien" role="status"><%= it.notice %></p><% } %>

<section class="reglage" aria-labelledby="r-token">
  <div>
    <h2 id="r-token">Token Claude</h2>
    <p>La clé avec laquelle ronde lance Claude. Elle est chiffrée en base et n'est jamais réaffichée.</p>
  </div>
  <div>
    <% if (t.configured) { %>
      <p><span class="etat ok">Configuré</span> <code><%= t.masked %></code>, <%= it.h.tokenTypeLabel(t.type) %>.</p>
      <% if (t.source === 'env') { %><p class="discret">Défini par une variable d'environnement du serveur : il est prioritaire et ne se modifie pas ici.</p><% } %>
      <% if (t.type === 'api') { %><p class="note attention">Clé API : chaque passage est facturé à l'usage sur la console Anthropic.</p><% } %>
    <% } else if (t.unreadable) { %>
      <p class="note attention">Le token enregistré est illisible : le secret de l'application a changé. Colle-le à nouveau.</p>
    <% } else { %>
      <p class="note attention">Aucun token : les rondes échoueront tant qu'il manque.</p>
    <% } %>

    <% if (t.source !== 'env') { %>
    <form method="post" action="/settings/token">
      <label><%= t.configured ? 'Remplacer le token' : 'Coller le token' %>
        <input type="password" name="claude_token" autocomplete="off" placeholder="sk-ant-oat…" required <%~ e.claude_token ? 'aria-invalid="true"' : '' %>>
        <small class="<%= e.claude_token ? 'erreur' : '' %>"><%= e.claude_token ?? 'Recommandé : « claude setup-token » sur ta machine. Il utilise ton abonnement Pro ou Max, sans facturation à part.' %></small>
      </label>
      <button type="submit">Enregistrer le token</button>
    </form>
    <% } %>

    <% if (t.configured) { %>
    <div class="actions" style="margin-top:1rem">
      <form method="post" action="/settings/token/test" hx-post="/settings/token/test" hx-target="#token-test"><button type="submit" class="secondaire">Tester le token</button></form>
      <% if (t.source === 'db') { %>
      <form method="post" action="/settings/token/delete"><button type="submit" class="danger">Supprimer le token</button></form>
      <% } %>
    </div>
    <div id="token-test" style="margin-top:1rem" aria-live="polite"></div>
    <% } %>
  </div>
</section>

<section class="reglage" aria-labelledby="r-mcp">
  <div>
    <h2 id="r-mcp">Accès MCP</h2>
    <p>Laisse Claude concevoir, essayer et créer des rondes avec toi, depuis Claude Code ou claude.ai.</p>
  </div>
  <div>
  <% if (!it.mcp.enabled) { %>
    <p class="note attention">Indisponible : la connexion MCP exige une adresse publique en HTTPS (variable <code>PUBLIC_URL</code>).</p>
  <% } else { %>
    <p>Dans ton terminal :</p>
    <div class="commande"><pre>claude mcp add --scope user --transport http ronde <%= it.mcp.url %></pre></div>
    <p class="discret">Puis dans Claude Code : <code>/mcp</code>, choisis ronde et connecte-toi. Le navigateur s'ouvre ici pour que tu autorises l'accès avec ton identifiant et ton mot de passe.</p>

    <h3 style="margin-top:1.75rem">Accès autorisés</h3>
    <% if (!it.grants.length) { %>
      <p class="discret">Aucun pour l'instant.</p>
    <% } else { %>
    <div class="defile">
    <table class="registre">
      <thead><tr><th>Client</th><th>Autorisé</th><th>Dernière utilisation</th><th class="fin"></th></tr></thead>
      <tbody>
      <% it.grants.forEach((g) => { %>
        <tr>
          <td><strong><%= g.client_name || 'Client MCP' %></strong> <span class="discret petit">par <%= g.username %></span></td>
          <td class="quand"><%= it.h.short(g.created_at) %></td>
          <td class="quand"><%= g.last_used_at ? it.h.ago(g.last_used_at) : '—' %></td>
          <td class="fin"><form method="post" action="/settings/mcp/grants/<%= g.id %>/revoke"><button type="submit" class="danger compact">Révoquer</button></form></td>
        </tr>
      <% }) %>
      </tbody>
    </table>
    </div>
    <% } %>

    <form method="post" action="/settings/mcp/tools" style="margin-top:1.75rem">
      <label>Outils que Claude peut donner à une ronde via MCP, un par ligne
        <textarea name="mcp_tools" rows="3" <%~ e.mcp_tools ? 'aria-invalid="true"' : '' %>><%= it.mcpTools.join('\n') %></textarea>
        <small class="<%= e.mcp_tools ? 'erreur' : '' %>"><%= e.mcp_tools ?? 'Par défaut : ' + it.defaultMcpTools.join(', ') + '. Bash, Write ou Edit donnent un shell ou l’écriture dans le conteneur : une ronde qui les utilise ne peut alors plus être modifiée via MCP.' %></small>
      </label>
      <button type="submit">Enregistrer les outils</button>
    </form>
  <% } %>
  </div>
</section>

<section class="reglage" aria-labelledby="r-alertes">
  <div>
    <h2 id="r-alertes">Alertes</h2>
    <p>Un mail part quand Claude ne répond pas « RAS » ou quand un passage échoue.</p>
  </div>
  <div>
    <% if (!it.smtpEnabled) { %>
    <p class="note attention">Envoi de mails non configuré sur le serveur (variable <code>SMTP_HOST</code>).</p>
    <% } %>
    <form method="post" action="/settings/alerts">
      <label>Destinataire
        <input type="email" name="alert_email" value="<%= it.alertEmail %>" placeholder="toi@exemple.fr" <%~ e.alert_email ? 'aria-invalid="true"' : '' %>>
        <small class="<%= e.alert_email ? 'erreur' : '' %>"><%= e.alert_email ?? 'Expéditeur : ' + it.smtpFrom %></small>
      </label>
      <div class="actions">
        <button type="submit">Enregistrer l'adresse</button>
      </div>
    </form>
    <% if (it.alertEmail && it.smtpEnabled) { %>
    <form method="post" action="/settings/alerts/test" style="margin-top:0.75rem">
      <button type="submit" class="secondaire">Envoyer un mail de test</button>
    </form>
    <% } %>
  </div>
</section>
