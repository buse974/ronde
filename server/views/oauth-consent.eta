<% layout('./layout', { ...it, title: 'Autoriser un accès' }) %>
<% const p = it.p; const local = /^(localhost|127\.0\.0\.1|\[::1\])(:\d+)?$/.test(p.redirectHost); %>
<div class="seul">
  <%~ include('./partials/embleme', { cls: 'embleme' }) %>
  <h1>Autoriser « <%= p.clientName %> »</h1>
  <p>Ce client pourra lister, essayer, créer, modifier et lancer des rondes. Il ne pourra ni supprimer une ronde ni changer les réglages.</p>
  <div class="destination">
    Le code d'accès sera envoyé à <strong><code><%= p.redirectHost %></code></strong>
    <small class="aide"><%= local ? 'Un programme sur ta machine, comme Claude Code.' : 'Un service en ligne.' %> N'autorise que si tu viens de lancer cette connexion toi-même.</small>
  </div>
  <% if (it.error) { %><p class="note mal"><%= it.error %></p><% } %>
  <form method="post" action="/oauth/consent">
    <input type="hidden" name="req" value="<%= it.reqId %>">
    <% if (it.user) { %>
      <p>Connecté en tant que <strong><%= it.user %></strong>.</p>
    <% } else { %>
      <label>Identifiant
        <input name="username" autocomplete="username" required autofocus>
      </label>
      <label>Mot de passe
        <input type="password" name="password" autocomplete="current-password" required>
      </label>
    <% } %>
    <div class="actions">
      <button type="submit" name="action" value="allow">Autoriser</button>
      <button type="submit" name="action" value="deny" class="secondaire" formnovalidate>Refuser</button>
    </div>
  </form>
  <p class="petit discret" style="margin-top:1.5rem">Les accès se révoquent dans Réglages, rubrique Accès MCP.</p>
</div>
