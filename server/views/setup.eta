<% layout('./layout', { ...it, title: 'Installation' }) %>
<% const v = it.values, e = it.errors; %>
<% const field = (k) => e[k] ? 'aria-invalid="true"' : '' %>
<div class="seul">
  <%~ include('./partials/embleme', { cls: 'embleme' }) %>
  <h1>Installer ronde</h1>
  <p>Crée le compte administrateur. Le code d'installation s'affiche dans les journaux du conteneur : <code>docker compose logs ronde</code>.</p>
  <% if (e._) { %><p class="note mal"><%= e._ %></p><% } %>
  <form method="post" action="/setup">
    <label>Code d'installation
      <input name="setup_code" value="<%= v.setup_code ?? '' %>" autocomplete="off" required <%~ field('setup_code') %>>
      <% if (e.setup_code) { %><small class="erreur"><%= e.setup_code %></small><% } %>
    </label>

    <fieldset>
      <legend>Compte administrateur</legend>
      <label>Identifiant
        <input name="username" value="<%= v.username ?? 'admin' %>" autocomplete="username" required <%~ field('username') %>>
        <% if (e.username) { %><small class="erreur"><%= e.username %></small><% } %>
      </label>
      <div class="deux">
        <label>Mot de passe
          <input type="password" name="password" autocomplete="new-password" minlength="10" required <%~ field('password') %>>
          <small class="<%= e.password ? 'erreur' : '' %>"><%= e.password ?? '10 caractères minimum.' %></small>
        </label>
        <label>Confirmation
          <input type="password" name="password_confirm" autocomplete="new-password" required <%~ field('password_confirm') %>>
          <% if (e.password_confirm) { %><small class="erreur"><%= e.password_confirm %></small><% } %>
        </label>
      </div>
    </fieldset>

    <fieldset>
      <legend>Facultatif</legend>
      <label>Token Claude
        <input type="password" name="claude_token" value="" autocomplete="off" placeholder="sk-ant-oat…" <%~ field('claude_token') %>>
        <small class="<%= e.claude_token ? 'erreur' : '' %>"><%= e.claude_token ?? 'Obtenu avec « claude setup-token ». Il utilise ton abonnement, sans facturation à part.' %></small>
      </label>
      <label>Email d'alerte
        <input type="email" name="alert_email" value="<%= v.alert_email ?? '' %>" placeholder="toi@exemple.fr" <%~ field('alert_email') %>>
        <small class="<%= e.alert_email ? 'erreur' : '' %>"><%= e.alert_email ?? 'Reçoit un mail quand une ronde signale un problème ou échoue.' %></small>
      </label>
    </fieldset>

    <button type="submit">Créer le compte</button>
  </form>
</div>
