# Tout est facultatif : ronde démarre sans .env.
# Le compte admin, le token Claude et l'email d'alerte se règlent dans l'UI.

# URL publique, utilisée pour les liens dans les mails d'alerte.
PUBLIC_URL=http://localhost:3000

# Fuseau des expressions cron.
TZ=Europe/Paris

# Envoi des alertes (relais SMTP).
SMTP_HOST=
SMTP_PORT=25
SMTP_FROM=ronde@example.com
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
SMTP_TLS_REJECT_UNAUTHORIZED=true

# Derrière un reverse proxy HTTPS : cookies Secure et IP client réelle.
# COOKIE_SECURE=true
# TRUST_PROXY=1

# Facultatif : secret applicatif (sinon généré dans /data/secret.key).
# APP_SECRET=
# Facultatif : token Claude imposé par l'environnement (prioritaire sur l'UI).
# CLAUDE_CODE_OAUTH_TOKEN=
